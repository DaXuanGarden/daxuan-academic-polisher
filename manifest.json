    "inputs": ["pasted prose", "attached manuscript passages", "Markdown or plain-text sections", "explicit journal, grant, or section preferences", "optional style anchor"],
    "outputs": ["polished passage in the routed language", "up to five genuine notes", "optional audit findings or draft flags"],
